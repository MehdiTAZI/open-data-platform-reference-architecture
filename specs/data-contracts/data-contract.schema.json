{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opendataplatform.dev/schemas/data-contract.schema.json",
  "title": "Open Data Platform Data Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "odp/v1alpha2"},
    "kind": {"const": "DataContract"},
    "metadata": {
      "type": "object",
      "required": ["name", "owner"],
      "properties": {
        "name": {"type": "string"},
        "owner": {"type": "string"}
      },
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "required": ["schema", "quality"],
      "properties": {
        "schema": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "type", "nullable"],
            "properties": {
              "name": {"type": "string"},
              "type": {"type": "string"},
              "nullable": {"type": "boolean"},
              "classification": {"enum": ["public", "internal", "confidential", "restricted"]}
            },
            "additionalProperties": false
          }
        },
        "quality": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "type", "severity", "action"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "type": {
                "enum": ["not_null", "not_blank", "unique", "accepted_values", "range", "regex", "freshness", "row_count"]
              },
              "column": {"type": "string"},
              "severity": {"enum": ["error", "warning"]},
              "action": {"enum": ["fail", "quarantine", "warn"]},
              "values": {"type": "array", "minItems": 1},
              "min": {"type": "number"},
              "max": {"type": "number"},
              "pattern": {"type": "string"},
              "maxAge": {"type": "string", "pattern": "^[1-9][0-9]*(s|m|h|d)$"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
